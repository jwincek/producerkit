# Files excluded from the distributed plugin zip (bin/build-dist.sh).
# These live in the repo but must not ship to WordPress.org. The plugin has
# no build step and no Composer runtime dependency, so the dist build is
# simply the repo minus development files.

.git
.github
.gitignore
.distignore
.editorconfig
.wp-env.json
.DS_Store
**/.DS_Store
composer.json
composer.lock
package.json
package-lock.json
phpcs.xml.dist
.eslintrc.json
.stylelintrc.json
node_modules
# Test suite and its harness. Nothing here runs for a user.
tests
phpunit.xml.dist
phpunit-integration.xml.dist
.phpunit.result.cache
# Generated by bin/build-dist.sh. Must be excluded, or the build nests a copy
# of itself inside its own output.
build
# WordPress.org listing artwork. This goes to the SVN assets/ directory,
# which is a sibling of trunk/ — it must never ship inside the plugin.
.wordpress-org
# The whole vendor tree, not just vendor/bin: composer.json declares no
# runtime dependencies (require is only php >=8.1) and the plugin loads its
# own files, so anything composer installs here is dev tooling — PHPCS,
# PHPUnit — that must never reach the zip. CI runs `composer install`, so a
# release built there would ship all of it if this were narrower.
vendor
bin
README.md
CHANGELOG.md
GETTING-STARTED.md
