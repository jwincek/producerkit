{
	"extends": [ "plugin:@wordpress/eslint-plugin/recommended" ],
	"env": {
		"browser": true
	},
	"globals": {
		"pkitSettings": "readonly",
		"qrcode": "readonly"
	},
	// Third-party, vendored verbatim (qrcode-generator, MIT).
	"ignorePatterns": [ "assets/js/vendor/**" ],
	"rules": {
		"no-console": [ "error", { "allow": [ "error", "warn" ] } ],
		"jsdoc/require-param-type": "off",

		// Both fight the no-build wp.element pattern, where conditional
		// branches of an element tree are expressed as ternaries inside a
		// createElement() argument list. Demoted to warnings so they stay
		// visible without blocking CI; fix incrementally.
		"no-nested-ternary": "warn",
		"@wordpress/no-unused-vars-before-return": "warn"
	},
	"overrides": [
		{
			// The editor entry points call hooks from functions passed as
			// PluginDocumentSettingPanel render props. Those really are
			// components, but ESLint only sees a plain function expression,
			// so every hook call in them reads as a violation.
			"files": [ "assets/js/editor-*.js" ],
			"rules": {
				"react-hooks/rules-of-hooks": "off"
			}
		}
	]
}
