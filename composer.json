{
    "name": "jwincek/farm-stand-manager",
    "description": "Products, sales locations, real-time availability, stand status, and events for small farms and farm stands.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Jerome Wincek",
            "homepage": "https://github.com/jwincek"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit",
        "test:integration": "phpunit -c phpunit-integration.xml.dist"
    }
}
