{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "producerkit/preorder-form",
    "version": "2.2.0",
    "title": "Pre-Order Form",
    "category": "producerkit",
    "icon": "cart",
    "description": "Let visitors pre-order products for pickup — pay on collection. Requires the Pre-Orders module.",
    "textdomain": "producerkit",
    "attributes": {
        "locationId": {
            "type": "number",
            "default": 0
        },
        "onlyAvailable": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": ["wide"],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "editorScript": "file:./index.js",
    "viewScriptModule": "file:./view.js",
    "render": "file:./render.php",
    "style": "file:./style.css"
}
