{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "lfuf/preorder-form",
    "version": "1.0.0",
    "title": "Pre-Order Form",
    "category": "leftfield",
    "icon": "cart",
    "description": "Let visitors pre-order products for pickup — pay at the stand. Requires the Pre-Orders module.",
    "textdomain": "farm-stand-manager",
    "attributes": {
        "locationId": {
            "type": "number",
            "default": 0
        },
        "onlyAvailable": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": ["wide"],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "editorScript": "file:./index.js",
    "viewScriptModule": "file:./view.js",
    "render": "file:./render.php",
    "style": "file:./style.css"
}
