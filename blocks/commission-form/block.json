{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "producerkit/commission-form",
    "version": "1.1.0",
    "title": "Commission Request Form",
    "category": "producerkit",
    "icon": "hammer",
    "description": "Let visitors ask for a custom piece. You quote a price; they accept or decline by email. Requires the Commissions module.",
    "textdomain": "producerkit",
    "attributes": {
        "heading": {
            "type": "string",
            "default": ""
        },
        "intro": {
            "type": "string",
            "default": ""
        },
        "showDeadline": {
            "type": "boolean",
            "default": true
        },
        "showBudget": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": ["wide"],
        "spacing": {
            "margin": true,
            "padding": true
        }
    },
    "editorScript": "file:./index.js",
    "viewScript": "file:./view.js",
    "render": "file:./render.php",
    "style": "file:./style.css"
}
